{
  "name": "prottype",
  "type": "module",
  "packageManager": "bun@1.2.21",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "bun run deploy:develop",
    "deploy:develop": "vite build && wrangler deploy",
    "deploy:staging": "vite build && wrangler deploy --env staging",
    "deploy:production": "vite build && wrangler deploy --env production",
    "deploy:preview": "vite build && wrangler versions upload",
    "preview": "vite build && vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "auth:schema": "bunx @better-auth/cli@1.4.21 generate --config ./app/modules/auth/create-auth.ts --output ./app/db/schema/auth/index.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply prottype --local",
    "db:migrate:remote": "wrangler d1 migrations apply prottype --remote",
    "db:migrate:remote:staging": "wrangler d1 migrations apply prottype-staging --remote --env staging",
    "db:migrate:remote:production": "wrangler d1 migrations apply prottype-production --remote --env production",
    "db:setup": "bun run auth:schema && bun run db:generate && bun run db:migrate:local",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rulesync": "rulesync generate --targets cursor --features rules,skills,mcp && prettier --write .cursor/",
    "rulesync:check": "bash scripts/rulesync-check.sh",
    "ci": "bun run lint && bun run format:check && bun run rulesync:check && bun run test && bun run build",
    "verify:repro": "bash scripts/verify-repro.sh",
    "skills:pack": "tar czf prottype-skills-pack.tgz .rulesync rulesync.jsonc docs/bootstrap-verify.md docs/stack.md docs/qa.md docs/deploy.md docs/architecture.md"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.20",
    "@hono/inertia": "0.2.0",
    "@hono/zod-validator": "0.7.6",
    "@inertiajs/core": "3.4.0",
    "@inertiajs/react": "3.4.0",
    "@radix-ui/react-slot": "1.3.0",
    "better-auth": "1.6.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.44.7",
    "drizzle-zod": "0.8.3",
    "hono": "4.12.27",
    "lucide-react": "0.511.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "vite-ssr-components": "0.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cloudflare/vite-plugin": "1.42.1",
    "@cloudflare/workers-types": "4.20260621.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "prettier": "3.8.4",
    "rulesync": "8.31.0",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vitest": "3.2.6",
    "wrangler": "4.103.0"
  }
}
